# Copy to .env and load with: set -a; source .env; set +a
APP_ENV=development
ADMIN_EMAIL=admin@haven.hk
# Local development only uses Haven2026 if this is empty.
# Production requires a NEW password of at least 12 characters.
ADMIN_PASSWORD=
DATA_DIR=./data
PORT=8000
PROPERTY_NAME='Belfast city centre Moon House'
PROPERTY_ADDRESS=
PROPERTY_TIMEZONE=Europe/London
# Confirm actual times with the owner, using 24-hour HH:MM format.
CHECKIN_TIME=
CHECKOUT_TIME=
# Use your mail provider's verified sender and SMTP credentials.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Enable only behind exactly one trusted reverse proxy, e.g. your hosting service.
TRUST_PROXY=0
