# Copy to .env and load with: set -a; source .env; set +a
APP_ENV=development
ADMIN_EMAIL=andrewteddyjp@gmail.com
# Local development only uses Haven2026 if this is empty.
# Production requires a NEW password of at least 12 characters.
ADMIN_PASSWORD=
DATA_DIR=./data
PORT=8000
PROPERTY_NAME='Belfast city centre Moon House'
PROPERTY_ADDRESS=
PROPERTY_TIMEZONE=Europe/London
# Confirm actual times with the owner, using 24-hour HH:MM format.
CHECKIN_TIME=
CHECKOUT_TIME=
# auto: Resend HTTPS when SMTP_HOST=smtp.resend.com or RESEND_API_KEY is set;
# otherwise SMTP. Set resend explicitly on Render to avoid SMTP port restrictions.
MAIL_TRANSPORT=auto
# Optional dedicated Resend key; existing SMTP_PASSWORD is used if this is empty.
RESEND_API_KEY=
# Use your mail provider's verified sender and credentials.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Enable only behind exactly one trusted reverse proxy, e.g. your hosting service.
TRUST_PROXY=0
